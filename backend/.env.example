# Comma-separated list of origins allowed to call this API (CORS).
# Use "*" to allow any origin (fine for testing, not recommended once
# real users are on this).
#
# Production — your deployed frontend origin(s):
ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Local dev — Vite's default dev server port:
# ALLOWED_ORIGINS=http://localhost:5173
# Multiple origins:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
